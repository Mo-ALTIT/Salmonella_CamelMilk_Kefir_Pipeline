# ── Model equations ──────────────────────────────────────────────────────────

def bigelow_log10(t, kmax, logN0):
    return logN0 - (kmax / np.log(10)) * np.asarray(t, float)

def weibull_log10(t, delta, p, logN0):
    t = np.maximum(np.asarray(t, float), 1e-12)
    return logN0 - (t / np.maximum(delta,1e-12)) ** np.maximum(p, 1e-4)

# ── Fitting functions ─────────────────────────────────────────────────────────

def fit_bigelow(t, y, logN0):
    popt, _ = curve_fit(lambda tt, k: bigelow_log10(tt, k, logN0),
                        t, y, p0=[0.3], bounds=([1e-6],[np.inf]), maxfev=20000)
    return ('kmax',), popt, 1

def fit_weibull(t, y, logN0):
    d0 = max(np.median(t[t>0]), 1e-2) if np.any(t>0) else 1.0
    popt, _ = curve_fit(lambda tt, d, p: weibull_log10(tt, d, p, logN0),
                        t, y, p0=[d0,1.0],
                        bounds=([1e-6,1e-4],[np.inf,10.0]), maxfev=20000)
    return ('delta','p'), popt, 2

FITTERS = [
    ('Bigelow', fit_bigelow, bigelow_log10, '-' ),
    ('Weibull', fit_weibull, weibull_log10,  '--'),
]

