# ── 5.13  Helper: build X_g from any DataFrame ─────────
#
# This function applies the SAME z-score scaling fitted on the training data.
# Call it with any external DataFrame to get a compatible design matrix.

def build_Xg(df_input, logN0_vals=None):
    """
    Build the (11, n_obs) design matrix for global models.

    Parameters
    ----------
    df_input   : DataFrame with columns TIME_COL, Kefir_Grains,
                 Fermentation_Time, Storage_Temperature
    logN0_vals : optional array of per-row logN0 values.
                 If None, uses df_input['logN0'].

    Returns
    -------
    np.ndarray of shape (11, n_obs)
    """
    KGs_ = _scale(df_input['Kefir_Grains'].values,        'KG')
    FTs_ = _scale(df_input['Fermentation_Time'].values,    'FT')
    STs_ = _scale(df_input['Storage_Temperature '].values,  'ST')
    t_   = df_input[TIME_COL].values.astype(float)
    lN0_ = (logN0_vals if logN0_vals is not None
            else df_input['logN0'].values).astype(float)
    return np.vstack([
        t_, lN0_,
        KGs_, FTs_, STs_,
        KGs_*FTs_, KGs_*STs_, FTs_*STs_,
        KGs_**2,   FTs_**2,   STs_**2,
    ])

