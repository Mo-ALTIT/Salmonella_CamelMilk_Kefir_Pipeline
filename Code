def build_rsm3(df_env, factors):
    """Linear + quadratic + pairwise interactions for 3 factors."""
    X, lbl = pd.DataFrame(index=df_env.index), {}
    for f in factors:
        X[f]            = df_env[f].values;         lbl[f]            = f'({f})'
        c = f'{f}_sq';  X[c] = df_env[f].values**2; lbl[c] = f'({f})²'
    for fi, fj in itertools.combinations(factors, 2):
        c = f'{fi}_x_{fj}'; X[c] = df_env[fi].values * df_env[fj].values
        lbl[c] = f'({fi}×{fj})'
    return X, lbl


def backward_ols(X_df, y, p_thresh=P_THRESH):
    """Backward stepwise OLS: remove highest-p predictor until all ≤ p_thresh."""
    rem = list(X_df.columns)
    while rem:
        mdl   = sm.OLS(y, sm.add_constant(X_df[rem], has_constant='add')).fit()
        pvals = mdl.pvalues.drop('const', errors='ignore')
        if pvals.empty or pvals.max() <= p_thresh:
            break
        rem.remove(pvals.idxmax())
    Xf = (sm.add_constant(X_df[rem], has_constant='add') if rem
          else sm.add_constant(pd.DataFrame(index=X_df.index), has_constant='add'))
    return sm.OLS(y, Xf).fit(), rem


