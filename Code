def calc_metrics(y_true, y_pred, k):
    """RSS · RMSE · R² · AIC · Bf · Af.  k = number of free model parameters."""
    yt = np.asarray(y_true, float);  yp = np.asarray(y_pred, float)
    n   = len(yt);   res = yp - yt
    rss = float(np.sum(res**2))
    return {
        'RSS' : rss,
        'RMSE': float(np.sqrt(rss / n)),
        'R2'  : float(r2_score(yt, yp)),
        'AIC' : float(n * np.log(rss / n + 1e-15) + 2 * k),
        'Bf'  : float(10.0 ** np.mean(res)),
        'Af'  : float(10.0 ** np.mean(np.abs(res))),
    }


def calc_apz(y_obs, y_pred):
    """% predictions inside Acceptable Prediction Zone (pred−obs convention)."""
    r      = np.asarray(y_pred, float) - np.asarray(y_obs, float)
    inside = np.sum((r >= APZ_LOWER) & (r <= APZ_UPPER))
    p      = 100.0 * inside / len(y_obs)
    return round(p, 2)


def parity_plot(ax, y_obs, y_pred, title, k=6,
                extra_obs=None, extra_pred=None, extra_label='External'):
    """Parity plot with APZ band.  Optional overlay of external validation points."""
    y_obs  = np.asarray(y_obs,  float)
    y_pred = np.asarray(y_pred, float)
    all_v  = [y_obs, y_pred]
    if extra_obs  is not None: all_v.append(np.asarray(extra_obs,  float))
    if extra_pred is not None: all_v.append(np.asarray(extra_pred, float))
    lo = np.floor(np.concatenate(all_v).min()) - 0.3
    hi = np.ceil (np.concatenate(all_v).max()) + 0.3
    lr = np.array([lo, hi])

    ax.scatter(y_obs, y_pred, color='black', s=20, alpha=0.65, zorder=5,
               label='Training/Test')
    if extra_obs is not None:
        ax.scatter(extra_obs, extra_pred, color='red', s=45, marker='^',
                   zorder=6, label=extra_label)
    ax.plot(lr, lr,            'k-',  lw=1.2, label='y=x')
    ax.plot(lr, lr + APZ_UPPER,'k--', lw=0.9, label=f'+{APZ_UPPER}')
    ax.plot(lr, lr + APZ_LOWER,'k:',  lw=0.9, label=f'{APZ_LOWER}')
    ax.fill_between(lr, lr+APZ_LOWER, lr+APZ_UPPER, color='grey', alpha=0.10)

    m = calc_metrics(y_obs, y_pred, k);  a = calc_apz(y_obs, y_pred)
    ax.text(0.04, 0.97,
            f"R²={m['R2']:.3f}\nRMSE={m['RMSE']:.3f}\nAPZ={a:.1f}%",
            transform=ax.transAxes, fontsize=8, va='top',
            bbox=dict(boxstyle='round,pad=0.3', fc='white', ec='grey', lw=0.4))
    ax.set_xlabel(r'Observed $\log_{10}$ $N$ (CFU mL$^{-1}$)')
    ax.set_ylabel(r'Predicted $\log_{10}$ $N$ (CFU mL$^{-1}$)')
    ax.set_title(title, fontsize=10)
    ax.set_xlim(lo, hi); ax.set_ylim(lo, hi)
    ax.set_aspect('equal', adjustable='datalim')
    ax.legend(loc='lower right', fontsize=7)


