def _quad10(p, start, Xg):
    """
    Evaluate the 10-term quadratic RSM polynomial.

    Parameters
    ----------
    p     : full parameter array (all model coefficients)
    start : index into p where this parameter's 10 coefficients begin
    Xg    : (11, n_obs) design matrix

    Returns
    -------
    1-D array of shape (n_obs,)
    """
    b = p[start: start + N_Q]
    return (b[0]
            + b[1]*Xg[2]  + b[2]*Xg[3]  + b[3]*Xg[4]    # linear
            + b[4]*Xg[5]  + b[5]*Xg[6]  + b[6]*Xg[7]    # interactions
            + b[7]*Xg[8]  + b[8]*Xg[9]  + b[9]*Xg[10])  # quadratic


# ── 5.5  Global model functions ───────────────────────────────────────────────

def global_bigelow_q(Xg, *p):
    """
    Global Bigelow — 10 free parameters.

    kmax(KG,FT,ST) = quadratic RSM (Correction C1)
    Clamp: kmax > 0  (Correction C4)
    """
    kmax = np.maximum(_quad10(p, 0, Xg), 1e-9)
    return Xg[1] - (kmax / np.log(10)) * Xg[0]


def global_weibull_q(Xg, *p):
    """
    Global Weibull — 20 free parameters (10 for delta + 10 for p).

    delta(KG,FT,ST) = quadratic RSM,  delta > 0   (Corrections C1 + C4)
    p(KG,FT,ST)     = quadratic RSM,  p  ∈ [0.1, 10]  (C4)

    Note: p is clipped, NOT clamped with maximum(), to keep the gradient
    well-defined at the boundary and prevent optimizer stagnation.
    """
    delta = np.maximum(_quad10(p,    0, Xg), 1e-9)
    pp    = np.clip(   _quad10(p, N_Q, Xg), 0.10, 10.0)
    return Xg[1] - (np.maximum(Xg[0], 1e-12) / delta) ** pp


# ── 5.6  Informed starting values  (Correction C3) ───────────────────────────

p0_bigelow            = np.zeros(N_Q)
p0_bigelow[0]         = kmax_mean        # intercept = mean(kmax)

p0_weibull            = np.zeros(2 * N_Q)
p0_weibull[0]         = delta_mean       # intercept = mean(delta)
p0_weibull[N_Q]       = p_mean          # intercept = mean(p)

print(f'\n[p0]  Bigelow: β0(kmax)  = {p0_bigelow[0]:.4f}')
print(f'[p0]  Weibull: β0(delta) = {p0_weibull[0]:.4f}')
print(f'[p0]  Weibull: β0(p)     = {p0_weibull[N_Q]:.4f}')

# ── 5.7  Bounds  (Correction C4) ─────────────────────────────────────────────
#
# Bounds are set in the scaled coefficient space.
# COEF_BOUND is generous (covers all plausible quadratic surfaces);
# only the intercepts are given tight lower bounds to prevent collapse.

COEF_BOUND = 20.0

# Bigelow  (10 params)
lb_big         = np.full(N_Q,  -COEF_BOUND)
ub_big         = np.full(N_Q,   COEF_BOUND)
lb_big[0]      = 1e-9       # kmax intercept must be positive
ub_big[0]      = 50.0

# Weibull  (20 params)
lb_wei         = np.full(2*N_Q, -COEF_BOUND)
ub_wei         = np.full(2*N_Q,  COEF_BOUND)
lb_wei[0]      = 1e-9       # delta intercept > 0
ub_wei[0]      = 500.0
lb_wei[N_Q]    = 0.05       # p intercept > 0.05
ub_wei[N_Q]    = 9.00

# ── 5.8  Configuration ────────────────────────────────────────────────────────

